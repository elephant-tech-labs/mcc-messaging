# Public base URL of this dedicated messaging service.
# Example: https://messaging.militarycreatorcon.com
APP_BASE_URL=

# Temporary server-to-server protection for outbound/admin endpoints.
# Do not place this value inside browser-side widget code.
MCC_SERVICE_KEY=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Existing MCC Supabase project
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Zoho CRM OAuth
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_API_DOMAIN=https://www.zohoapis.com
# Optional browser UI base used for Open in CRM buttons. Default is US DC.
ZOHO_CRM_WEB_BASE=https://crm.zoho.com

# Zoho Cliq OAuth / REST API v3
ZOHO_CLIQ_CLIENT_ID=
ZOHO_CLIQ_CLIENT_SECRET=
ZOHO_CLIQ_REFRESH_TOKEN=
ZOHO_CLIQ_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_CLIQ_API_BASE=https://cliq.zoho.com/api/v3

# Dedicated verifier for Zoho Cliq webhook-bot callbacks.
# Generate a strong random value and keep it server-side only.
ZOHO_CLIQ_WEBHOOK_SECRET=
